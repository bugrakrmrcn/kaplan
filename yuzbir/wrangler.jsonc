{
  // 101 Çağrı — Cloudflare Worker ayarları
  "name": "yuzbir",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "GROUP", "class_name": "Group" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group"] }],
  "vars": { "PLAYERS": "Sarsi,Kerman,Buğra,Yigü,Arda" },
  "observability": { "enabled": true }
  // Gizli değer (wrangler secret put GROUP_KEY): davet anahtarı
}
